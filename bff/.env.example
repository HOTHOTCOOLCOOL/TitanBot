# =============================================================================
# Nanobot BFF Gateway — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# All variables use the BFF_ prefix to avoid collisions with Nanobot's env.
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
BFF_HOST=127.0.0.1
BFF_PORT=8099

# ── Auth & Rate Limiting ──────────────────────────────────────────────────────
BFF_TOKENS_PATH=./user_tokens.json
BFF_RATE_LIMIT_RPM=60          # Max requests per user per minute

# ── Upstream Provider ─────────────────────────────────────────────────────────
# Supported: azure | anthropic | openai | deepseek | (any LiteLLM-supported provider)
BFF_UPSTREAM_PROVIDER=azure

# Azure OpenAI (used when BFF_UPSTREAM_PROVIDER=azure)
BFF_AZURE_API_KEY=your-azure-api-key-here
BFF_AZURE_API_BASE=https://your-resource-name.openai.azure.com
BFF_AZURE_API_VERSION=2024-08-01-preview

# Generic provider (used when BFF_UPSTREAM_PROVIDER != azure)
# BFF_GENERIC_API_KEY=sk-your-anthropic-or-openai-key-here
# BFF_GENERIC_API_BASE=https://api.anthropic.com/v1

# ── Model Mapping ─────────────────────────────────────────────────────────────
# Maps the model name Nanobot sends → the actual upstream deployment/model ID.
# JSON format. Leave as {} to pass model names through unchanged.
#
# Azure example (deployment names):
# BFF_MODEL_MAP={"gpt-4o": "azure/my-gpt4o-deployment", "gpt-4o-mini": "azure/my-gpt4o-mini"}
#
# Anthropic example:
# BFF_MODEL_MAP={"claude-opus-4-5": "anthropic/claude-opus-4-5"}
BFF_MODEL_MAP={}

# ── Timeouts ──────────────────────────────────────────────────────────────────
# Seconds to wait for upstream response before giving up.
# Set high for reasoning models (o1/o3) that may take 60-120s for first token.
BFF_UPSTREAM_TIMEOUT=120
